{
  "name": "claude-harness-desktop",
  "version": "1.0.0",
  "description": "Claude Harness Desktop — A visual multi-project cockpit for Claude Code",
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:electron": "tsc --project tsconfig.node.json",
    "dev-electron": "concurrently \"vite\" \"wait-on file:.vite/port && tsc --project tsconfig.node.json && cross-env NODE_ENV=development electron .\"",
    "build": "tsc --project tsconfig.node.json && vite build",
    "electron": "electron .",
    "start": "npm run build && electron .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "adm-zip": "^0.5.17",

    "fs-extra": "^11.2.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {

    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.8.3",
    "typescript": "^5.9.0",
    "vite": "^8.0.3",
    "wait-on": "^7.2.0"
  }
}
